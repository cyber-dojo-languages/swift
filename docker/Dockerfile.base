# The official swift image on its floating latest tag, so a rebuild picks up
# the newest stable release. It is published as an index holding real amd64
# and arm64 layers, so each runner builds from binaries its own kernel can
# exec, and it puts swiftc on the default PATH.
FROM swift:latest
LABEL maintainer=byran@adgico.co.uk
LABEL maintainer=jon@jaggersoft.com
